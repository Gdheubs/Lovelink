{
  "name": "@loverlink/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loverlink API + realtime server. Domain-pure core, vendor SDKs isolated in adapters.",
  "main": "dist/main.js",
  "scripts": {
    "dev:memory": "cross-env PERSISTENCE=memory tsx watch src/main.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "migrate": "tsx src/adapters/postgres/migrate.ts up",
    "migrate:status": "tsx src/adapters/postgres/migrate.ts status",
    "smoke": "tsx scripts/smoke.ts",
    "room-check": "tsx scripts/roomLoadCheck.ts",
    "safety-check": "tsx scripts/safetyCheck.ts",
    "ladder-check": "tsx scripts/ladderCheck.ts",
    "seed:dev": "node scripts/seedDev.mjs",
    "pulse-check": "node scripts/pulseCheck.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.9.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
