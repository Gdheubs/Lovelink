# =============================================================================
# Production Environment Variables for Render Deployment
#
# Copy values from services and paste into Render dashboard
# =============================================================================

# --- Node Configuration ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Database (Supabase) ---
# Get from: Supabase Project Settings → Database → Connection pooling
# Transaction Pooler (port 6543):
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Direct Connection (port 5432) - for migrations ONLY:
DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# SSL required for Supabase
DATABASE_SSL=true

# --- Persistence ---
PERSISTENCE=postgres
REALTIME_IN_PROCESS=true
PRESENCE_TTL_SECONDS=45
PRESENCE_REAP_INTERVAL_SECONDS=15

# --- Redis (Upstash) ---
# Get from: Upstash Console → Redis Instance → Details
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# --- HTTP & CORS ---
# CRITICAL: CORS_ORIGINS must be EXACT frontend URL (including protocol)
CORS_ORIGINS=https://yourdomain.vercel.app
PUBLIC_WEB_URL=https://yourdomain.vercel.app

# Enable when behind Cloudflare (ONLY if firewalled to Cloudflare IPs)
TRUST_PROXY=true

# --- LiveKit Voice (Phase 3+) ---
# Get from: LiveKit Cloud Console → Project Settings
LIVEKIT_URL=wss://[PROJECT].livekit.cloud
LIVEKIT_API_KEY=[YOUR_API_KEY]
LIVEKIT_API_SECRET=[MUST_BE_32_CHARS_MIN]

# --- Authentication Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER share these. Use Render's secret management.
ACCESS_TOKEN_SECRET=[64_HEX_CHARS]
REFRESH_TOKEN_SECRET=[64_HEX_CHARS]

# --- Web Push (Optional) ---
# Generate with: npx web-push generate-vapid-keys --json
# Can be set later if not needed immediately
# VAPID_PUBLIC_KEY=[YOUR_PUBLIC_KEY]
# VAPID_PRIVATE_KEY=[YOUR_PRIVATE_KEY]
# VAPID_SUBJECT=mailto:your@email.com

# --- SMS/Auth Notifications (Optional) ---
# If not set, codes are printed to logs (dev only)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=[YOUR_SID]
# TWILIO_AUTH_TOKEN=[YOUR_TOKEN]
# TWILIO_FROM_NUMBER=+1234567890

# --- Observability (Optional) ---
# For external log aggregation
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example.com
