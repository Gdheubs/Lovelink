# =============================================================================
# Loverlink Environment — Production on Render + Supabase
#
# Copy this to `.env` on your machine and fill in the values from your
# deployed services, then deploy to Render.
# =============================================================================

# --- Deployment Mode -------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PERSISTENCE=postgres
REALTIME_IN_PROCESS=true

# --- Database (Supabase) ---------------------------------------------------
# Get these from Supabase Project Settings → Database → Connection pooling
# 
# DATABASE_URL uses the Transaction Pooler (port 6543) for runtime queries
# DATABASE_DIRECT_URL uses the direct connection (port 5432) for migrations ONLY
#
# Both should start with: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@...
#
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Redis (Upstash) -------------------------------------------------------
# Get this from Upstash console (starts with rediss://)
#
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# --- HTTP ------------------------------------------------------------------
# CORS_ORIGINS: must be your Vercel frontend URL, EXACTLY as it appears in browser
# Example: https://yourdomain.vercel.app
#
# TRUST_PROXY=true ONLY if ALL traffic comes through Cloudflare
# (Cloudflare → Render path is firewalled, so cf-connecting-ip is trustworthy)
#
CORS_ORIGINS=https://yourdomain.vercel.app
PUBLIC_WEB_URL=https://yourdomain.vercel.app
TRUST_PROXY=true

# --- LiveKit (Voice) -------------------------------------------------------
# Get these from LiveKit Cloud console
# LIVEKIT_API_SECRET must be at least 32 characters
#
LIVEKIT_URL=wss://[PROJECT].livekit.cloud
LIVEKIT_API_KEY=[YOUR_API_KEY]
LIVEKIT_API_SECRET=[YOUR_API_SECRET_32_CHARS_MIN]

# --- Web Push (optional, can be added later) --------------------------------
# Generate with: npx web-push generate-vapid-keys --json
#
# VAPID_PUBLIC_KEY=[YOUR_PUBLIC_KEY]
# VAPID_PRIVATE_KEY=[YOUR_PRIVATE_KEY]
# VAPID_SUBJECT=mailto:your@email.com

# --- Auth ------------------------------------------------------------------
# These are validated at boot and MUST be set in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
ACCESS_TOKEN_SECRET=[64_HEX_CHARS]
REFRESH_TOKEN_SECRET=[64_HEX_CHARS]

# --- SMS/Notifications (optional) -------------------------------------------
# SMS provider for login codes. Supported: twilio, vonage
# If not set, codes are printed to logs (development only)
#
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=...

# --- Observability (optional) -----------------------------------------------
# Structured logging is built-in (pino). Optional external observability:
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.com
