# =============================================================================
# Loverlink environment. Copy to `.env` and edit.
#
# Every variable here is validated at boot by apps/server/src/config.ts, which
# refuses to start rather than run half-configured. Nothing else in the codebase
# reads process.env — if you need a new setting, add it to that schema so it is
# typed, documented and validated.
#
# The defaults below are enough to run `npm run dev:memory` with no services at
# all. Production REJECTS these defaults; see the production block at the bottom.
# =============================================================================

NODE_ENV=development

# Which family of adapters to wire up.
#   memory   — every port backed by an in-process fake. No Docker needed.
#   postgres — real Postgres + Redis (+ LiveKit when media is enabled).
PERSISTENCE=memory

# --- HTTP --------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Comma-separated. A wildcard is refused in production: these requests carry
# credentials, and `*` plus credentials is an account-takeover primitive.
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# --- realtime ----------------------------------------------------------------
# true  — Socket.io mounts on the API's HTTP server (the MVP default).
# false — run apps/server/src/realtime.ts as its own process.
# The module boundary exists from day one so this is a config change, not a refactor.
REALTIME_IN_PROCESS=true
REALTIME_PORT=4001

# Seconds without a heartbeat before a member is treated as gone. Tune with care:
# too low and a subway tunnel ejects people mid-conversation; too high and the
# member list is full of ghosts.
PRESENCE_TTL_SECONDS=45
PRESENCE_REAP_INTERVAL_SECONDS=15

# --- auth --------------------------------------------------------------------
# >= 32 characters in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# DEVELOPMENT ONLY. Returns the login code in the API response and prints it to
# the log, so signup works with no SMS or email provider configured.
# Production refuses to boot with this on — it hands every account to anyone who
# knows a phone number.
AUTH_ECHO_CODE=true

# --- postgres ----------------------------------------------------------------
DATABASE_URL=postgres://loverlink:loverlink@localhost:5432/loverlink
DATABASE_POOL_MAX=10

# --- redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- livekit (Phase 3) -------------------------------------------------------
# The browser-facing URL. wss:// in production, behind Cloudflare.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-32
LIVEKIT_TOKEN_TTL_SECONDS=3600

# Shared secret for coturn. Must match infra/livekit.yaml.
TURN_SECRET=dev-turn-secret

# --- moderation --------------------------------------------------------------
# Comma-separated user UUIDs with moderator powers. A config allowlist rather
# than a database role: anyone who can write a user row must not be able to mint
# a moderator. See domain/rules/moderation.ts.
MODERATOR_USER_IDS=

# Shared secret for the server-rendered admin pages.
ADMIN_TOKEN=dev-admin-token

# --- observability -----------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# =============================================================================
# PRODUCTION CHECKLIST — config.ts enforces every one of these and will refuse
# to start otherwise:
#
#   NODE_ENV=production
#   PERSISTENCE=postgres          (memory loses all data on restart)
#   JWT_SECRET                    >= 32 chars, not the default
#   ADMIN_TOKEN                   not the default
#   LIVEKIT_API_SECRET            not the default
#   AUTH_ECHO_CODE=false
#   CORS_ORIGINS                  no wildcard
#   LOG_PRETTY=false              (ship structured JSON)
# =============================================================================
