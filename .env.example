# =============================================================================
# Loverlink environment. Copy to `.env` and edit.
#
# Every variable here is validated at boot by apps/server/src/config.ts, which
# refuses to start rather than run half-configured. Nothing else in the codebase
# reads process.env — if you need a new setting, add it to that schema so it is
# typed, documented and validated.
#
# The defaults below are enough to run `npm run dev:memory` with no services at
# all. Production REJECTS these defaults; see the production block at the bottom.
# =============================================================================

NODE_ENV=development

# Which family of adapters to wire up.
#   memory   — every port backed by an in-process fake. No Docker needed.
#   postgres — real Postgres + Redis (+ LiveKit when media is enabled).
PERSISTENCE=memory

# --- HTTP --------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Comma-separated. A wildcard is refused in production: these requests carry
# credentials, and `*` plus credentials is an account-takeover primitive.
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Trust `cf-connecting-ip` / `x-forwarded-for` to name the real client.
#
# ONLY SET THIS TRUE WHEN THE ORIGIN IS LOCKED TO CLOUDFLARE. Behind Cloudflare
# with the origin firewalled to its ranges, those headers are authoritative
# because Cloudflare overwrites them. On a directly reachable origin they are
# attacker-controlled, and trusting them lets anyone evade every per-IP rate
# limit by sending a different value each request.
TRUST_PROXY=false

# --- realtime ----------------------------------------------------------------
# true  — Socket.io mounts on the API's HTTP server (the MVP default).
# false — run apps/server/src/realtime.ts as its own process.
# The module boundary exists from day one so this is a config change, not a refactor.
REALTIME_IN_PROCESS=true
REALTIME_PORT=4001

# Seconds without a heartbeat before a member is treated as gone. Tune with care:
# too low and a subway tunnel ejects people mid-conversation; too high and the
# member list is full of ghosts.
PRESENCE_TTL_SECONDS=45
PRESENCE_REAP_INTERVAL_SECONDS=15

# --- auth --------------------------------------------------------------------
# >= 32 characters in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# DEVELOPMENT ONLY. Returns the login code in the API response and prints it to
# the log, so signup works with no SMS or email provider configured.
# Production refuses to boot with this on — it hands every account to anyone who
# knows a phone number.
AUTH_ECHO_CODE=true

# --- postgres (Supabase in production) ---------------------------------------
# Supabase gives you THREE connection strings and they are not interchangeable:
#
#   :5432 direct    one real session per connection      -> DATABASE_DIRECT_URL
#   :5432 pooler    session mode
#   :6543 pooler    transaction mode                     -> DATABASE_URL
#
# The running app wants transaction mode: the pooler provides the concurrency,
# so each container holds a small pool. Nothing here depends on session state
# (see adapters/postgres/db.ts) and the adapter logs which mode it detected.
#
# MIGRATIONS MUST USE THE DIRECT URL. The migration runner takes a session-level
# advisory lock so two deploys cannot apply the same migration; a transaction
# pooler cannot hold that lock, and both would think they had it.
DATABASE_URL=postgres://loverlink:loverlink@localhost:5432/loverlink
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=10

# TLS to the database. Off locally (the container has no certificate); production
# refuses to start without it, because managed Postgres is reached over the
# public internet and an unencrypted connection fails silently — everything works.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- redis -------------------------------------------------------------------
# Supabase provides no Redis. Managed Redis (Upstash, Redis Cloud) is a
# connection-string change. Redis is doing four things nothing else does:
# presence with explicit expiry, atomic rate-limit counters, the Socket.io
# cross-process adapter, and the room chat ring buffer.
REDIS_URL=redis://localhost:6379

# --- livekit (Phase 3) -------------------------------------------------------
# The browser-facing URL. wss:// in production, behind Cloudflare.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-32
LIVEKIT_TOKEN_TTL_SECONDS=3600

# Shared secret for coturn. Must match infra/livekit.yaml.
TURN_SECRET=dev-turn-secret

# --- moderation --------------------------------------------------------------
# Comma-separated user UUIDs with moderator powers. A config allowlist rather
# than a database role: anyone who can write a user row must not be able to mint
# a moderator. See domain/rules/moderation.ts.
MODERATOR_USER_IDS=

# Shared secret for the server-rendered admin pages.
ADMIN_TOKEN=dev-admin-token

# --- object storage: Cloudflare R2 -------------------------------------------
# Optional. With no bucket the object store reports itself unavailable and
# nothing that would need it is offered. Nothing uses it yet — the port exists
# so the video pipeline has a boundary to be built against.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only if a domain serves the bucket. Without one, `urlFor(key, null)` returns
# null rather than fabricating a URL that 403s.
R2_PUBLIC_BASE_URL=

# --- web push ----------------------------------------------------------------
# Optional. No keys means no push: clients never offer to subscribe, and every
# feature behaves as it does with notifications switched off.
# Generate with: npx web-push generate-vapid-keys
#
# VAPID_SUBJECT is not decoration — it is how a push service reaches a human
# when a deployment misbehaves, rather than simply blocking it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- observability -----------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# =============================================================================
# PRODUCTION CHECKLIST — config.ts enforces every one of these and will refuse
# to start otherwise:
#
#   NODE_ENV=production
#   PERSISTENCE=postgres          (memory loses all data on restart)
#   JWT_SECRET                    >= 32 chars, not the default
#   ADMIN_TOKEN                   not the default
#   LIVEKIT_API_SECRET            not the default
#   AUTH_ECHO_CODE=false
#   CORS_ORIGINS                  no wildcard
#   DATABASE_SSL=true
#   DATABASE_URL                  not localhost
#   REDIS_URL                     not localhost
#   LOG_PRETTY=false              (ship structured JSON)
#
# NOT ENFORCED BY CONFIG, BUT REQUIRED IN PRODUCTION:
#
#   TRUST_PROXY=true              once the origin is firewalled to Cloudflare —
#                                 and NOT before, or per-IP limits stop working
#   DATABASE_DIRECT_URL           so migrations do not run through the pooler
#
# =============================================================================
# DEPLOYMENT TOPOLOGY (see docs/adr/0008-managed-platform-topology.md)
#
#   Vercel        the Next.js web app, and only that
#   container     this API + realtime server — Fly, Railway, Render or a VPS.
#                 It CANNOT run on Vercel: it holds thousands of open
#                 WebSockets, keeps a Redis subscription, and runs the room
#                 scheduler on an interval. Serverless has nowhere to put those.
#   Supabase      Postgres + pgvector. Not Auth, not Realtime — see the ADR.
#   Redis         managed (Upstash / Redis Cloud)
#   Cloudflare    DNS, WAF, CDN, and R2
#   LiveKit       LiveKit Cloud, or self-hosted beside the API
#
# docker-compose.yml is LOCAL DEVELOPMENT ONLY. It is no longer the production
# topology and must not be read as one.
# =============================================================================
