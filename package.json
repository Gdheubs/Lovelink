{
  "name": "loverlink",
  "version": "0.1.0",
  "private": true,
  "description": "Loverlink — voice-first digital third place. Dependency-free core, ports & adapters.",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:memory": "npm run dev:memory --workspace @loverlink/server",
    "dev": "npm run dev --workspace @loverlink/server",
    "dev:web": "npm run dev --workspace @loverlink/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate --workspace @loverlink/server",
    "lint": "eslint apps/server/src",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,md}\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,md}\" \"docs/**/*.md\" \"*.md\"",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "type": "module"
}
